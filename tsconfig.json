{
	"compilerOptions": {
		"target": "es2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2023", "DOM"],
		"types": ["node"],
		"strict": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"declaration": true,
		"rootDir": "src",
		"outDir": "dist"
	},
	"include": ["src"]
}
