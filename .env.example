# UGent Entra ID account (both OTRS and UC sit behind it)
ENTRA_USERNAME="someone@ugent.be"
ENTRA_PASSWORD="your_password"
ENTRA_TOTP_SECRET="BASE32SECRET"

# OpenScape UC's own login dialog (the UC account, not the UGent one). Only needed for `uc`.
UC_USERNAME="uc_user"
UC_PASSWORD="uc_password"

# Optional
# COOKIE_PROFILE_DIR="./.cookie-profile"
# OTRS_URL="https://otrsdict.ugent.be/znuny/index.pl"
# UC_URL="https://uc.ugent.be/"

# Optional, for `uauth-cookie serve`
# COOKIE_SERVER_HOST="127.0.0.1"
# COOKIE_SERVER_PORT="8787"
# COOKIE_SERVER_TOKEN="a-long-random-string"
# COOKIE_KEEPALIVE_SECONDS="120"
